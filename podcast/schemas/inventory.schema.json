{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "month": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://[^\\s]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string"
          },
          "categoryHint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "date",
          "categoryHint"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "month",
    "sources",
    "digest"
  ],
  "additionalProperties": false
}
